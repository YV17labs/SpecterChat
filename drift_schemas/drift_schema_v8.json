  "fixed_sql": [
    {
      "name": "conversations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"conversations\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"system_prompt\" TEXT NULL, \"settings\" TEXT NULL, \"last_prompt_tokens\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"id\" TEXT NOT NULL, \"conversation_id\" TEXT NOT NULL REFERENCES conversations (id), \"role\" TEXT NOT NULL, \"content\" TEXT NOT NULL, \"completion_tokens\" INTEGER NOT NULL DEFAULT 0, \"duration_ms\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"is_streaming\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_streaming\" IN (0, 1)), \"updated_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attachments\" (\"id\" TEXT NOT NULL, \"message_id\" TEXT NOT NULL REFERENCES messages (id) ON DELETE CASCADE, \"mime_type\" TEXT NOT NULL, \"data\" BLOB NOT NULL, \"byte_size\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
